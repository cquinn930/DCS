[Unit]
Description=DCS UI (Next.js)
After=network.target dcs-api.service

[Service]
Type=simple
User=www-data
Group=dcs
WorkingDirectory=/opt/sites/DCS/services/ui
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_API_URL=https://dcs.flnet.local
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
