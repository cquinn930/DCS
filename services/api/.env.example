# DCS API Configuration
# Copy to .env and update values

# Application
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://dcs:dcs@localhost:5432/dcs

# Redis
REDIS_URL=redis://:dcs_redis_dev@localhost:6379/0

# JWT Authentication
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-USE-STRONG-RANDOM-VALUE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OIDC (Optional)
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Compliance Defaults
DEFAULT_JURISDICTION=NJ
DEFAULT_RETENTION_YEARS=7
